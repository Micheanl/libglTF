#version 460
#extension GL_EXT_mesh_shader : require
layout(local_size_x = MESH_WORKGROUP_SIZE, local_size_y = 1, local_size_z = 1) in;
layout(triangles, max_vertices = 256, max_primitives = 256) out;
layout(set = 0, binding = PROJECTION_BINDING, std140) uniform Projection { mat4 ProjMat; };
layout(set = 0, binding = DYNAMIC_TRANSFORMS_BINDING, std140) uniform DynamicTransforms { mat4 ModelViewMat; mat4 TextureMat; vec4 ColorModulator; vec3 ModelOffset; };
layout(set = 0, binding = LIGHTING_BINDING, std140) uniform Lighting { vec3 Light0_Direction; vec3 Light1_Direction; };
layout(set = 0, binding = SAMPLER1_BINDING) uniform sampler2D Sampler1;
layout(set = 0, binding = SAMPLER2_BINDING) uniform sampler2D Sampler2;
layout(push_constant) uniform Parameters { vec4 primitiveSphere; vec4 screenSizeAndFlags; uint instanceCount; uint meshletCount; uint instanceCulling; uint meshletCulling; uint baseCandidate; uint meshBatch; } parameters;
layout(set = 1, binding = INSTANCES_BINDING, std430) readonly buffer Instances { uint instanceWords[]; };
struct Meshlet { vec4 sphere; uint vertexOffset; uint triangleOffset; uint vertexCount; uint triangleCount; uint firstIndex; uint indexCount; uint padding0; uint padding1; vec4 cone; vec4 coneApex; vec4 positionBias; };
layout(set = 1, binding = MESHLETS_BINDING, std430) readonly buffer Meshlets { Meshlet meshlets[]; };
layout(set = 1, binding = MESHLET_VERTICES_BINDING, std430) readonly buffer MeshletVertices { uint meshletVertices[]; };
layout(set = 1, binding = MESHLET_TRIANGLES_BINDING, std430) readonly buffer MeshletTriangles { uint meshletTriangleWords[]; };
#ifdef MESH_OCCLUSION_CULLING
layout(set = 1, binding = DEPTH_BINDING) uniform sampler2D DepthSampler;
bool occludedByDepth(vec4 sphere, mat4 clipTransform, mat4 viewTransform) {
    vec4 clipCenter = clipTransform * vec4(sphere.xyz, 1.0);
    if (clipCenter.w <= 0.0) return false;
    vec2 ndc = clipCenter.xy / clipCenter.w;
    vec2 uv = ndc * 0.5 + 0.5;
    if (any(lessThan(uv, vec2(0.0))) || any(greaterThan(uv, vec2(1.0)))) return false;
    float viewDepth = -clipCenter.w;
    float nearView = viewDepth - sphere.w;
    if (nearView <= 0.0) return false;
    float focalPixels = ProjMat[1][1] * parameters.screenSizeAndFlags.y * 0.5;
    float radiusPx = max(sphere.w * focalPixels / viewDepth, 1.0);
    if (radiusPx < 3.0) return false;
    vec3 viewCenter = (viewTransform * vec4(sphere.xyz, 1.0)).xyz;
    vec3 viewFront = viewCenter * (1.0 - sphere.w / length(viewCenter));
    vec4 clipFront = ProjMat * vec4(viewFront, 1.0);
    float frontDevice = clipFront.z / clipFront.w;
#ifndef RENDERPEARL_DEPTH_IS_ZERO_TO_ONE
    frontDevice = frontDevice * 0.5 + 0.5;
#endif
    vec2 step = vec2(radiusPx / parameters.screenSizeAndFlags.x, radiusPx / parameters.screenSizeAndFlags.y);
    float nearest = 1.0;
    nearest = min(nearest, texture(DepthSampler, uv).r);
    nearest = min(nearest, texture(DepthSampler, uv + vec2(step.x, 0.0)).r);
    nearest = min(nearest, texture(DepthSampler, uv - vec2(step.x, 0.0)).r);
    nearest = min(nearest, texture(DepthSampler, uv + vec2(0.0, step.y)).r);
    nearest = min(nearest, texture(DepthSampler, uv - vec2(0.0, step.y)).r);
    return frontDevice > nearest + 0.001;
}
#endif
layout(location = 0) out float sphericalVertexDistance[];
layout(location = 1) out float cylindricalVertexDistance[];
layout(location = 2) out vec4 vertexColor[];
layout(location = 3) out vec4 lightMapColor[];
layout(location = 4) out vec4 overlayColor[];
layout(location = 5) out vec2 texCoord0[];
mat4 instanceMatrix(uint o) {
    return mat4(uintBitsToFloat(instanceWords[o]), uintBitsToFloat(instanceWords[o + 1]), uintBitsToFloat(instanceWords[o + 2]), uintBitsToFloat(instanceWords[o + 3]), uintBitsToFloat(instanceWords[o + 4]), uintBitsToFloat(instanceWords[o + 5]), uintBitsToFloat(instanceWords[o + 6]), uintBitsToFloat(instanceWords[o + 7]), uintBitsToFloat(instanceWords[o + 8]), uintBitsToFloat(instanceWords[o + 9]), uintBitsToFloat(instanceWords[o + 10]), uintBitsToFloat(instanceWords[o + 11]), uintBitsToFloat(instanceWords[o + 12]), uintBitsToFloat(instanceWords[o + 13]), uintBitsToFloat(instanceWords[o + 14]), uintBitsToFloat(instanceWords[o + 15]));
}
bool visibleSphere(vec4 sphere, mat4 transform) {
    vec4 r0 = vec4(transform[0][0], transform[1][0], transform[2][0], transform[3][0]);
    vec4 r1 = vec4(transform[0][1], transform[1][1], transform[2][1], transform[3][1]);
    vec4 r2 = vec4(transform[0][2], transform[1][2], transform[2][2], transform[3][2]);
    vec4 r3 = vec4(transform[0][3], transform[1][3], transform[2][3], transform[3][3]);
    vec4 c = vec4(sphere.xyz, 1.0);
    vec4 planes[6] = vec4[6](r3 + r0, r3 - r0, r3 + r1, r3 - r1, r3 + r2, r3 - r2);
    for (uint i = 0; i < 6; i++) if (dot(planes[i], c) < -sphere.w * length(planes[i].xyz)) return false;
    return true;
}
int signed16(uint value) { return int(value << 16) >> 16; }
uint triangleByte(uint offset) { return meshletTriangleWords[offset >> 2] >> ((offset & 3) * 8) & 255; }
vec2 signNotZero(vec2 value) { return vec2(value.x >= 0.0 ? 1.0 : -1.0, value.y >= 0.0 ? 1.0 : -1.0); }
vec3 decodeOct(uint oct) {
    vec2 encoded = vec2(float(int(oct << 24) >> 24), float(int(oct << 16) >> 24)) / 127.0;
    vec3 decoded = vec3(encoded, 1.0 - abs(encoded.x) - abs(encoded.y));
    if (decoded.z < 0.0) decoded.xy = (1.0 - abs(decoded.yx)) * signNotZero(decoded.xy);
    return normalize(decoded);
}
vec4 mixLight(vec3 normal, vec4 color) {
    vec2 light = max(vec2(0.0), vec2(dot(Light0_Direction, normal), dot(Light1_Direction, normal)));
    float value = min(1.0, (light.x + light.y) * 0.6 + 0.4);
    return vec4(color.rgb * value, color.a);
}
vec4 sampleLightmap(ivec2 uv) {
    vec2 coord = clamp((vec2(uv) / 256.0) + 0.5 / 16.0, vec2(0.5 / 16.0), vec2(15.5 / 16.0));
    return texture(Sampler2, coord);
}
void main() {
    uint invocation = gl_LocalInvocationIndex;
    uint candidate = parameters.baseCandidate + gl_WorkGroupID.x;
    uint candidateCount = parameters.instanceCount * parameters.meshletCount;
    uint instanceIndex = candidate < candidateCount ? candidate / parameters.meshletCount : 0;
    uint meshletIndex = candidate < candidateCount ? candidate - instanceIndex * parameters.meshletCount : 0;
    mat4 worldTransform = instanceMatrix(instanceIndex * 41);
    mat4 clipTransform = ProjMat * ModelViewMat * worldTransform;
    bool instanceVisible = parameters.instanceCulling == 0 || visibleSphere(parameters.primitiveSphere, clipTransform);
    bool meshletVisible = parameters.meshletCulling == 0 || visibleSphere(meshlets[meshletIndex].sphere, clipTransform);
    Meshlet meshlet = meshlets[meshletIndex];
#if defined(MESH_CONE_CULLING) || defined(MESH_OCCLUSION_CULLING)
    mat4 viewTransform = ModelViewMat * worldTransform;
#endif
#ifdef MESH_CONE_CULLING
    vec3 axisView = normalize(mat3(viewTransform) * meshlet.cone.xyz);
    vec3 apexView = (viewTransform * vec4(meshlet.coneApex.xyz, 1.0)).xyz;
    bool backfacing = dot(axisView, apexView) > meshlet.cone.w * length(apexView);
#else
    bool backfacing = false;
#endif
    if (candidate >= candidateCount) {
        SetMeshOutputsEXT(0, 0);
        return;
    }
    if (!(instanceVisible && meshletVisible) || backfacing) {
        SetMeshOutputsEXT(0, 0);
        return;
    }
#ifdef MESH_OCCLUSION_CULLING
    if (parameters.screenSizeAndFlags.z > 0.0 && occludedByDepth(meshlet.sphere, clipTransform, viewTransform)) {
        SetMeshOutputsEXT(0, 0);
        return;
    }
#endif
    SetMeshOutputsEXT(meshlet.vertexCount, meshlet.triangleCount);
    uint io = instanceIndex * 41;
    mat3 normalTransform = mat3(uintBitsToFloat(instanceWords[io + 16]), uintBitsToFloat(instanceWords[io + 17]), uintBitsToFloat(instanceWords[io + 18]), uintBitsToFloat(instanceWords[io + 20]), uintBitsToFloat(instanceWords[io + 21]), uintBitsToFloat(instanceWords[io + 22]), uintBitsToFloat(instanceWords[io + 24]), uintBitsToFloat(instanceWords[io + 25]), uintBitsToFloat(instanceWords[io + 26]));
    vec4 instanceColor = vec4(uintBitsToFloat(instanceWords[io + 28]), uintBitsToFloat(instanceWords[io + 29]), uintBitsToFloat(instanceWords[io + 30]), uintBitsToFloat(instanceWords[io + 31]));
    uint light = instanceWords[io + 32];
    uint overlay = instanceWords[io + 33];
    vec2 uvOffset = vec2(uintBitsToFloat(instanceWords[io + 35]), uintBitsToFloat(instanceWords[io + 36]));
    mat2 uvTransform = mat2(uintBitsToFloat(instanceWords[io + 37]), uintBitsToFloat(instanceWords[io + 39]), uintBitsToFloat(instanceWords[io + 38]), uintBitsToFloat(instanceWords[io + 40]));
#ifdef OIT_ALPHA_ONLY
    vec4 lightMapColorValue = vec4(1.0);
    vec4 overlayColorValue = vec4(0.0);
#else
    vec4 lightMapColorValue = sampleLightmap(ivec2(signed16(light), signed16(light >> 16)));
    vec4 overlayColorValue = texelFetch(Sampler1, ivec2(signed16(overlay), signed16(overlay >> 16)), 0);
#endif
    for (uint vertex = invocation; vertex < meshlet.vertexCount; vertex += gl_WorkGroupSize.x) {
        uint vo = (meshlet.vertexOffset + vertex) * 4;
        uint q0 = meshletVertices[vo];
        uint q1 = meshletVertices[vo + 1];
        uint q2 = meshletVertices[vo + 2];
        vec3 position = meshlet.positionBias.xyz +
            vec3(float(q0 & 0xFFFFu), float(q0 >> 16), float(q1 & 0xFFFFu)) * meshlet.positionBias.w;
        vec3 normal = decodeOct(q1 >> 16);
        vec2 uv = unpackHalf2x16(q2);
        vec2 uv0 = uvOffset + uvTransform * uv;
        vec4 color = unpackUnorm4x8(meshletVertices[vo + 3]);
        vec4 worldPosition = worldTransform * vec4(position, 1.0);
        vec3 worldNormal = normalize(normalTransform * normal);
        gl_MeshVerticesEXT[vertex].gl_Position = ProjMat * ModelViewMat * worldPosition;
        sphericalVertexDistance[vertex] = length(worldPosition.xyz);
        cylindricalVertexDistance[vertex] = max(length(worldPosition.xz), abs(worldPosition.y));
        vertexColor[vertex] = mixLight(worldNormal, color * instanceColor);
        lightMapColor[vertex] = lightMapColorValue;
        overlayColor[vertex] = overlayColorValue;
        texCoord0[vertex] = uv0;
    }
    for (uint triangle = invocation; triangle < meshlet.triangleCount; triangle += gl_WorkGroupSize.x) {
        uint offset = meshlet.triangleOffset + triangle * 3;
        gl_PrimitiveTriangleIndicesEXT[triangle] = uvec3(triangleByte(offset), triangleByte(offset + 1), triangleByte(offset + 2));
    }
}
